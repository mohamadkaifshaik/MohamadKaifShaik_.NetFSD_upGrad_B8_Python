@model Shopee.EmployeeCRM.Mvc.ViewModels.TaskFormViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<h2>@Model.PageTitle</h2>

<form method="post" class="card card-body shadow-sm border-0">
    <input asp-for="Task.Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Task.Title" class="form-label"></label>
            <input asp-for="Task.Title" class="form-control" />
            <span asp-validation-for="Task.Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Task.EmployeeId" class="form-label">Assigned Employee</label>
            <select asp-for="Task.EmployeeId" asp-items="Model.Employees" class="form-select"></select>
            <span asp-validation-for="Task.EmployeeId" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Task.Description" class="form-label"></label>
            <textarea asp-for="Task.Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-md-2">
            <label asp-for="Task.Status" class="form-label"></label>
            <select asp-for="Task.Status" asp-items="Model.StatusOptions" class="form-select"></select>
        </div>
        <div class="col-md-2">
            <label asp-for="Task.DueDate" class="form-label"></label>
            <input asp-for="Task.DueDate" type="date" class="form-control" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
