@model Shopee.EmployeeCRM.Mvc.ViewModels.EmployeeFormViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<h2>@Model.PageTitle</h2>

<form method="post" class="card card-body shadow-sm border-0">
    <input asp-for="Employee.Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Employee.FullName" class="form-label"></label>
            <input asp-for="Employee.FullName" class="form-control" />
            <span asp-validation-for="Employee.FullName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.Email" class="form-label"></label>
            <input asp-for="Employee.Email" class="form-control" />
            <span asp-validation-for="Employee.Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.Department" class="form-label"></label>
            <input asp-for="Employee.Department" class="form-control" />
            <span asp-validation-for="Employee.Department" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.Designation" class="form-label"></label>
            <input asp-for="Employee.Designation" class="form-control" />
            <span asp-validation-for="Employee.Designation" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.Role" class="form-label"></label>
            <select asp-for="Employee.Role" asp-items="Model.RoleOptions" class="form-select"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.JoinedOn" class="form-label"></label>
            <input asp-for="Employee.JoinedOn" type="date" class="form-control" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
